# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Used by docker-compose.yml and the backend (local/prod profiles).

# Database
DB_NAME=qesma
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/qesma
DB_USER=qesma
DB_PASSWORD=change-me

# Auth (required in prod; no defaults)
# Signing key for access tokens: base64 of at least 32 random bytes. Generate with: openssl rand -base64 32
QESMA_JWT_SECRET=
# Comma-separated Google OAuth client ids accepted as the ID token audience
GOOGLE_CLIENT_IDS=

# Spring profile: local | test | prod
# For local development without Google, use: SPRING_PROFILES_ACTIVE=local,fake-auth (never with prod)
SPRING_PROFILES_ACTIVE=local
