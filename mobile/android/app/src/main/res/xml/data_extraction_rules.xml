<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): the same rules for cloud backup and for device-to-device transfer (SA5, A128/A162). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/qesma_local.sqlite"/>
        <exclude domain="root" path="app_flutter/qesma_local.sqlite-wal"/>
        <exclude domain="root" path="app_flutter/qesma_local.sqlite-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/qesma_local.sqlite"/>
        <exclude domain="root" path="app_flutter/qesma_local.sqlite-wal"/>
        <exclude domain="root" path="app_flutter/qesma_local.sqlite-shm"/>
    </device-transfer>
</data-extraction-rules>
