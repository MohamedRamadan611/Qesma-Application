{
  "name": "V1 basic exact split with payer not participating",
  "input": {
    "members": [ { "id": "M", "sortOrder": 1 }, { "id": "A", "sortOrder": 2 }, { "id": "S", "sortOrder": 3 } ],
    "expenses": [
      { "type": "EXACT", "totalMinor": 10000,
        "payers": [ { "memberId": "M", "amountMinor": 10000 } ],
        "shares": [ { "memberId": "A", "amountMinor": 5000 }, { "memberId": "S", "amountMinor": 5000 } ] },
      { "type": "EXACT", "totalMinor": 3000,
        "payers": [ { "memberId": "S", "amountMinor": 3000 } ],
        "shares": [ { "memberId": "A", "amountMinor": 3000 } ] }
    ],
    "settlements": []
  },
  "expected": {
    "expenses": [ { "owed": { "A": 5000, "S": 5000 } }, { "owed": { "A": 3000 } } ],
    "nets": { "M": 10000, "A": -8000, "S": -2000 },
    "transfers": [
      { "fromMemberId": "A", "toMemberId": "M", "amountMinor": 8000 },
      { "fromMemberId": "S", "toMemberId": "M", "amountMinor": 2000 }
    ]
  }
}
