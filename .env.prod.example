# Copy to .env.prod (git-ignored) and fill EVERY value. Used by docker-compose.prod.yml.
# Generate secrets on the server, never reuse the development ones:
#   QESMA_JWT_SECRET:  openssl rand -base64 32
#   DB_PASSWORD:       openssl rand -base64 24

# Public host name (DNS A/AAAA record must point at this server) and an address for certificate notices.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Database
DB_NAME=qesma
DB_USER=qesma
DB_PASSWORD=

# Backend
QESMA_JWT_SECRET=
# Comma-separated Google OAuth client ids (Android + web as needed)
GOOGLE_CLIENT_IDS=

# Optional
# QESMA_VERSION=1.0.0
# BACKUP_PATH=/var/backups/qesma
# BACKUP_RETENTION_DAYS=14
